{
  "name": "@arnilo/prism-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Private reference host for testing and proof. Not an API.",
  "type": "module",
  "bin": {
    "prism-agent": "./bin/prism-agent.ts"
  },
  "scripts": {
    "eval:baseline": "bun src/evals/suite.ts --write-baseline",
    "test": "bun ../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "test:live:journey:commandcode": "PRISM_LIVE_JOURNEY_PROVIDER=commandcode bun test --timeout=0 src/__tests__/live-provider-journey.test.ts",
    "test:live:journey:ollama-cloud": "PRISM_LIVE_JOURNEY_PROVIDER=ollama-cloud bun test --timeout=0 src/__tests__/live-provider-journey.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@arnilo/prism-memory-system": "workspace:*",
    "@arnilo/prism-ai": "workspace:*",
    "@arnilo/prism-extensions": "workspace:*",
    "@arnilo/prism-tools": "workspace:*",
    "@arnilo/prism-hosts": "^0.13.0",
    "@arnilo/prism-knowledge": "0.13.0-experimental.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "license": "MIT"
}
