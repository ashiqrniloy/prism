    "@arnilo/prism-context-files": "workspace:*",
    "@arnilo/prism-delegate": "workspace:*",
    "@arnilo/prism-driver-process": "workspace:*",
    "@arnilo/prism-evals": "workspace:*",
    "@arnilo/prism-headless": "workspace:*",
    "@arnilo/prism-hooks-json": "workspace:*",
    "@arnilo/prism-memory-compaction": "workspace:*",
    "@arnilo/prism-memory-fabric": "workspace:*",
    "@arnilo/prism-memory-observational": "workspace:*",
    "@arnilo/prism-memory-rag": "workspace:*",
    "@arnilo/prism-memory-wiki": "workspace:*",
    "@arnilo/prism-provider-hyper": "workspace:*",
    "@arnilo/prism-remote": "workspace:*",
    "@arnilo/prism-store-sqlite": "workspace:*",
    "@arnilo/prism-tools-browser": "workspace:*",
    "@arnilo/prism-tools-coding": "workspace:*",
    "@arnilo/prism-tools-research": "workspace:*",
    "@arnilo/prism-tools-web": "workspace:*",
    "@arnilo/prism-workflows": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT"
}
