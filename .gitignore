dist/

# compiled example demos (emitted by docs.test tsc step; never commit)
examples/*.js
node_modules/
release-artifacts/
bug-reports/
code-reviews/
scripts/unused-sweep-report.txt
scripts/coverage-summary.json
coverage/
scripts/postgres-evidence.json
scripts/release-evidence.json
scripts/lint-report.sarif
scripts/unused-report.json

# live credential files — names-only *.example stays tracked, real files never (see scripts/live.env.example)
scripts/live.env
*.local.env

# operator-supplied local secrets (plan 140 Task 6); never commit
/.local/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# binary lockfile — never commit if saveTextLockfile is flipped (plan 113)
bun.lockb

# plan 140 Task 3: prism-code standalone binaries
dist-bin/

# local runtime state and agent config (never part of a release)
/.prism/
/.claude/
/laya-amd-setup.md
/163-prism-feature-request.md
