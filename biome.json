{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/dist", "!**/node_modules", "!**/coverage", "!**/*.json"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 140
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "off",
        "noControlCharactersInRegex": "off",
        "noAssignInExpressions": "off",
        "noShadowRestrictedNames": "off",
        "noThenProperty": "off"
      },
      "correctness": {
        "noVoidTypeReturn": "off",
        "useYield": "off"
      },
      "complexity": { "noExcessiveCognitiveComplexity": "off" },
      "style": {
        "useImportType": "off",
        "noNonNullAssertion": "error",
        "useNodejsImportProtocol": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["examples/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["packages/acp-agent/src/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["packages/ag-ui/src/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["packages/mcp/src/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["packages/memory/src/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["packages/office/src/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["packages/prism-coding-tools/src/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["packages/prism-core/src/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["packages/prism-providers/src/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": ["packages/web-tools/src/**"],
      "linter": { "rules": { "style": { "noNonNullAssertion": "off" } } }
    },
    {
      "includes": [
        "src/agent-approval.ts",
        "src/agent-loops.ts",
        "src/agent-tool-dispatch.ts",
        "packages/prism-coding-tools/src/agent/delete.ts",
        "packages/prism-coding-tools/src/agent/git*.ts",
        "packages/prism-coding-tools/src/agent/glob-match.ts",
        "packages/prism-coding-tools/src/agent/language/framing.ts",
        "packages/prism-coding-tools/src/security/sandbox-fs-operations.ts",
        "packages/prism-coding-tools/src/security/sandbox-tar.ts"
      ],
      "linter": { "rules": { "style": { "noNonNullAssertion": "error" } } }
    }
  ]
}
