{
  "name": "@arnilo/prism-model-router",
  "version": "0.2.7",
  "description": "Optional model governance router: allow-list, residency, budgets, fallback, circuits, and redacted diagnostics.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs node --test dist/__tests__/model-router.test.js dist/__tests__/selection.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@arnilo/prism": "0.2.7"
  },
  "devDependencies": {
    "@arnilo/prism": "file:../.."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/model-router"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/model-router#readme",
  "keywords": [
    "prism",
    "model-router",
    "governance",
    "residency",
    "circuit-breaker"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
