{
  "name": "@arnilo/prism-wiki",
  "version": "0.0.2",
  "description": "Karpathy LLM Wiki system with local qmd hybrid search and Context7 navigation for Prism.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "prism-wiki": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "!dist/__tests__",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs node --test dist/__tests__/*.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@arnilo/prism": "^0.3.1"
  },
  "devDependencies": {
    "@arnilo/prism": "file:../.."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/prism-wiki"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/prism-wiki#readme",
  "keywords": [
    "prism",
    "wiki",
    "llm-wiki",
    "karpathy",
    "qmd",
    "context7",
    "knowledge-base",
    "agent",
    "extension"
  ],
  "sideEffects": [
    "dist/cli.js"
  ],
  "publishConfig": {
    "access": "public"
  }
}
