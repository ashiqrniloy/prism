{
  "name": "@arnilo/prism-computer-use-linux",
  "version": "0.3.0",
  "description": "Optional Prism Linux desktop tools over a host-owned computer-use-linux MCP binary.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "skills"
  ],
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs node --test dist/__tests__/*.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@arnilo/prism": "^0.3.0",
    "@arnilo/prism-mcp": "^0.3.0"
  },
  "devDependencies": {
    "@arnilo/prism": "file:../..",
    "@arnilo/prism-mcp": "file:../mcp"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/computer-use-linux"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/computer-use-linux#readme",
  "keywords": [
    "prism",
    "computer-use",
    "linux",
    "desktop",
    "mcp",
    "tools",
    "agent"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
