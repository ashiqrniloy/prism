{
  "name": "@arnilo/prism-hooks-json",
  "version": "0.13.0",
  "description": "Claude/Codex hooks.json compiled onto Prism hooks. SessionStart is session.opened; the other events stay on context.build, run.input, tool.call, tool.result, and run.end.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/integrations/hooks-json"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/integrations/hooks-json#readme",
  "keywords": [
    "prism",
    "hooks",
    "hooks.json",
    "claude-code",
    "codex"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
