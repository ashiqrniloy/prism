{
  "name": "@arnilo/prism-observability",
  "version": "0.13.0",
  "description": "OpenTelemetry spans and metrics over the Prism agent event catalog. Exports nothing itself: the host registers its own OpenTelemetry SDK.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@arnilo/prism-evals": "file:../../hosts/evals",
    "@arnilo/prism-memory-core": "file:../../memory/core",
    "@arnilo/prism-memory-rag": "file:../../memory/rag",
    "@arnilo/prism-workflows": "file:../workflows",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2",
    "@opentelemetry/api": "1.9.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/integrations/observability"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/integrations/observability#readme",
  "keywords": [
    "prism",
    "observability",
    "opentelemetry",
    "tracing",
    "metrics",
    "package"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  }
}
