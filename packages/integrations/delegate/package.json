{
  "name": "@arnilo/prism-delegate",
  "version": "0.13.0",
  "description": "Sub-agents as a tool: a delegate tool whose child agent inherits a chosen subset of the parent packages, with child activity reported as delegate.step package events.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0"
  },
  "devDependencies": {
    "@arnilo/prism-tools-coding": "file:../../tools/coding",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/integrations/delegate"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/integrations/delegate#readme",
  "keywords": [
    "prism",
    "delegate",
    "sub-agent",
    "multi-agent",
    "package"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
