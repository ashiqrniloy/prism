{
  "name": "@arnilo/prism-mcp",
  "version": "0.13.0",
  "description": "Bounded MCP tools, resources, prompts, client callbacks, and authorized Streamable HTTP sessions.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "pack:dry-run": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@arnilo/prism-governance": "^0.13.0",
    "@modelcontextprotocol/client": "^2.3.0",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/server": "^2.3.0"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/integrations/mcp"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/integrations/mcp#readme",
  "keywords": [
    "prism",
    "mcp",
    "model-context-protocol",
    "tools",
    "agent"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
