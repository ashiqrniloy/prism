{
  "name": "@arnilo/prism-host-builder",
  "version": "0.13.0",
  "description": "Host library with reference indexes, a skill, an MCP server and an installer that help coding agents build and change Prism hosts against the installed version.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "prism-host-builder": "./bin/prism-host-builder.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "bin",
    "data",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@arnilo/prism-mcp-server": "^0.13.0",
    "@modelcontextprotocol/server": "^2.3.0",
    "zod": "^4.6.2"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/hosts/host-builder"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/hosts/host-builder#readme",
  "keywords": [
    "prism",
    "host",
    "coding-agent",
    "skill",
    "mcp",
    "reference"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
