{
  "name": "@arnilo/prism-acp",
  "version": "0.13.0",
  "description": "Host library serving one Prism agent over the Agent Client Protocol.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/hosts/acp"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/hosts/acp#readme",
  "keywords": [
    "prism",
    "acp",
    "agent-client-protocol",
    "host"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
