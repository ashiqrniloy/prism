{
  "name": "@arnilo/prism-core",
  "version": "0.4.0",
  "description": "Core runtime, sessions, governance, credentials, enterprise state, and work integrations family package for Prism.",
  "type": "module",
  "exports": {
    "./runtime/server": {
      "types": "./dist/runtime/server/index.d.ts",
      "default": "./dist/runtime/server/index.js"
    },
    "./runtime/server/artifact-bodies": {
      "types": "./dist/runtime/server/artifact-bodies.d.ts",
      "default": "./dist/runtime/server/artifact-bodies.js"
    },
    "./runtime/supervisor": {
      "types": "./dist/runtime/supervisor/index.d.ts",
      "default": "./dist/runtime/supervisor/index.js"
    },
    "./runtime/workflows": {
      "types": "./dist/runtime/workflows/index.d.ts",
      "default": "./dist/runtime/workflows/index.js"
    },
    "./sessions/codecs": {
      "types": "./dist/sessions/codecs/index.d.ts",
      "default": "./dist/sessions/codecs/index.js"
    },
    "./sessions/sqlite": {
      "types": "./dist/sessions/sqlite/index.d.ts",
      "default": "./dist/sessions/sqlite/index.js"
    },
    "./sessions/postgres": {
      "types": "./dist/sessions/postgres/index.d.ts",
      "default": "./dist/sessions/postgres/index.js"
