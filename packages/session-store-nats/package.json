{
  "name": "@arnilo/prism-session-store-nats",
  "version": "0.2.7",
  "description": "Optional NATS JetStream AgentEventSource adapter for Prism.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs node --test dist/__tests__/*.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@nats-io/jetstream": "^3.4.0",
    "@nats-io/transport-node": "^3.4.0"
  },
  "peerDependencies": {
    "@arnilo/prism": "0.2.7"
  },
  "devDependencies": {
    "@arnilo/prism": "file:../.."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/session-store-nats"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/session-store-nats#readme",
  "keywords": [
    "prism",
    "nats",
    "jetstream",
    "agent-event-source",
    "durable",
    "replay"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
