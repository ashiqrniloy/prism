{
  "name": "@arnilo/prism-session-store-codecs",
  "version": "0.1.6",
  "description": "Shared row codecs for Prism SQL session stores; the only store-specific seam is the redacted-boolean representation.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "npm pack --dry-run"
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@arnilo/prism": "0.1.6"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/session-store-codecs"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/session-store-codecs#readme",
  "keywords": [
    "prism",
    "session-store",
    "codecs",
    "persistence"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
