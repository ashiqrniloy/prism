{
  "name": "@arnilo/prism-memory-system",
  "version": "0.13.0-experimental.0",
  "description": "The Prism memory system: session tiers (short-term memory, working memory, rehearsal) that observe the session, keep a source-backed ledger and compact from memory, plus long-term memory (the ltm component: typed notes, scopes, recall, consolidation and lifecycle behind the memory.* tools).",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/fixtures",
    "!src/**/*.js",
    "!src/**/*.js.map",
    "!src/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "test:postgres": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src/ltm/__tests__/postgres-memory.integration.test.ts src/ltm/__tests__/postgres-vector.integration.test.ts src/ltm/__tests__/postgres-propagation.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0",
    "pg": "^8.23.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "dependencies": {
    "@arnilo/prism-memory-core": "0.13.0-experimental.0"
  },
  "devDependencies": {
    "@arnilo/prism-memory-compaction": "file:../compaction",
    "@arnilo/prism-rag": "file:../../knowledge/rag",
    "@types/node": "^22.20.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/memory/system"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/memory/system#readme",
  "keywords": [
    "prism",
    "memory",
    "memory-system",
    "session-memory",
    "long-term-memory",
    "context",
    "agent",
    "package"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
