{
  "name": "@arnilo/prism-memory-core",
  "version": "0.13.0",
  "description": "Shared memory contracts, stores, lineage, propagation, and scoring used by the Prism memory packages. A plain library with no package definition, no slot, and no capability.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./fabric": "./src/fabric/index.ts",
    "./postgres": "./src/postgres/index.ts",
    "./sqlite": "./src/sqlite/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/*.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0",
    "pg": "^8.23.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/pg": "^8.23.1",
    "pg": "^8.23.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/memory/core"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/memory/core#readme",
  "keywords": [
    "prism",
    "memory",
    "vector-store",
    "pgvector",
    "lineage",
    "library"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
