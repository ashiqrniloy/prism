{
  "name": "@arnilo/prism-memory-observational",
  "version": "0.13.0",
  "description": "Observational memory for Prism: a package that observes the session in the background, keeps a source-backed ledger, recalls evidence by id, and compacts from memory instead of the raw transcript.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "!src/**/*.js",
    "!src/**/*.js.map",
    "!src/**/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/memory/observational"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/memory/observational#readme",
  "keywords": [
    "prism",
    "memory",
    "observational-memory",
    "context",
    "agent",
    "package"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
