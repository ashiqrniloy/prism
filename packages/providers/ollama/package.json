{
  "name": "@arnilo/prism-provider-ollama",
  "version": "0.12.1",
  "description": "Ollama Cloud / local provider package for Prism: registers the ollama provider, resolves its optional key from an `env:`/`keyring:` ref per request, and ships the OpenAI-compatible wire and model catalog.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "mkdir -p node_modules/@arnilo && ln -sfn ../../../../.. node_modules/@arnilo/prism"
  },
  "peerDependencies": {
    "@arnilo/prism": "^0.12.1"
  },
  "devDependencies": {
    "@arnilo/prism": "file:../../..",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/providers/ollama"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/providers/ollama#readme",
  "keywords": [
    "prism",
    "provider",
    "ollama",
    "local",
    "chat-completions"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
