{
  "name": "@arnilo/prism-provider-ollama-cloud",
  "version": "0.13.0",
  "description": "Ollama Cloud provider package for Prism: native NDJSON /api/chat plus the OpenAI-compatible /v1/chat/completions route, hosted-model discovery, plan limits, and the model catalog.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/providers/ollama-cloud"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/providers/ollama-cloud#readme",
  "keywords": [
    "prism",
    "provider",
    "ollama",
    "ollama-cloud",
    "native-ndjson",
    "chat-completions"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
