{
  "name": "@arnilo/prism-provider-openai-codex",
  "version": "0.13.0",
  "description": "OpenAI Codex provider package for Prism: OpenAI models on a ChatGPT plan via Sign in with ChatGPT, with an OAuth grant in a `keyring:` ref, per-request refresh, the stateless Responses wire, and the model catalog.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/providers/openai-codex"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/providers/openai-codex#readme",
  "keywords": [
    "prism",
    "provider",
    "openai",
    "codex",
    "chatgpt",
    "responses"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
