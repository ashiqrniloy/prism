{
  "name": "@arnilo/prism-provider-ai-sdk",
  "version": "0.12.1",
  "description": "AI SDK bridge provider package for Prism: adapts a host-owned LanguageModelV4 into a Prism provider without adding an AI SDK dependency to the kernel. The @ai-sdk/provider peer is optional.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "postinstall": "mkdir -p node_modules/@arnilo && ln -sfn ../../../../.. node_modules/@arnilo/prism"
  },
  "peerDependencies": {
    "@arnilo/prism": "^0.12.1",
    "@ai-sdk/provider": "4.0.13"
  },
  "devDependencies": {
    "@ai-sdk/openai": "4.0.65",
    "@ai-sdk/provider": "4.0.13",
    "@arnilo/prism": "file:../../..",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/providers/ai-sdk"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/providers/ai-sdk#readme",
  "keywords": [
    "prism",
    "provider",
    "ai-sdk",
    "vercel",
    "language-model"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    }
  }
}
