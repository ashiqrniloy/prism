{
  "name": "@arnilo/prism-graft",
  "version": "0.0.1",
  "description": "Graft context-graph integration for Prism.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs node --test dist/__tests__/*.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@arnilo/prism": "^0.3.0",
    "@nanonets/graft": "^0.13.0"
  },
  "peerDependenciesMeta": {
    "@nanonets/graft": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arnilo/prism": "file:../.."
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/prism-graft"
  },
  "bugs": {
    "type": "url",
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/prism-graft#readme",
  "keywords": [
    "prism",
    "graft",
    "context-graph",
    "agent",
    "extension"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
