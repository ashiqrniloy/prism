{
  "name": "@arnilo/prism-tools-computer-use",
  "version": "0.13.0",
  "description": "First-party Linux desktop tools for Prism: the host-owned computer-use-linux MCP binary with declared external effects and in-tool device admission.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "test:live": "bun test --timeout=0 src/__tests__/live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0",
    "@arnilo/prism-mcp": "^0.13.0"
  },
  "peerDependenciesMeta": {
    "@arnilo/prism-mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arnilo/prism-approval": "file:../../policy/approval",
    "@arnilo/prism-mcp": "file:../../integrations/mcp",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/tools/computer-use"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/tools/computer-use#readme",
  "keywords": [
    "prism",
    "computer-use",
    "desktop",
    "mcp",
    "tools",
    "agent",
    "package"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
