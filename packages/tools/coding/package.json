{
  "name": "@arnilo/prism-tools-coding",
  "version": "0.13.0",
  "description": "First-party coding tools for Prism: file, search, and shell tools as a package, with in-tool path containment and declared effects.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0",
    "@arnilo/prism-workflows": "^0.13.0",
    "e2b": "2.49.1"
  },
  "devDependencies": {
    "@arnilo/prism-workflows": "file:../../integrations/workflows",
    "@arnilo/prism-evals": "file:../../hosts/evals",
    "@types/diff": "^7.0.2",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/tools/coding"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/tools/coding#readme",
  "keywords": [
    "prism",
    "coding",
    "tools",
    "agent",
    "package"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "e2b": {
      "optional": true
    }
  }
}
