{
  "name": "@arnilo/prism-tools-browser",
  "version": "0.13.0",
  "description": "First-party browser automation tools for Prism: six exclusive Playwright tools with declared effects, egress policy, and artifact quarantine.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "skills",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "test:live": "bun test --timeout=0 src/__tests__/live.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0",
    "playwright-core": "1.63.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arnilo/prism-approval": "file:../../policy/approval",
    "@arnilo/prism-evals": "file:../../hosts/evals",
    "@arnilo/prism-tools-web": "file:../web",
    "@types/node": "^22.20.0",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/tools/browser"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/tools/browser#readme",
  "keywords": [
    "prism",
    "browser",
    "playwright",
    "cdp",
    "tools",
    "agent",
    "package"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
