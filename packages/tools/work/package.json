{
  "name": "@arnilo/prism-tools-work",
  "version": "0.13.0",
  "description": "First-party work tools for Prism: Office documents, spreadsheets, diagrams, connectors, and a bounded document reader, with declared effects and ref-only credentials.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./connectors": "./src/connectors/index.ts",
    "./connectors/drafts": "./src/connectors/drafts.ts",
    "./connectors/google-workspace": "./src/connectors/google-workspace.ts",
    "./connectors/microsoft365": "./src/connectors/microsoft365.ts",
    "./diagrams": "./src/diagrams/index.ts",
    "./document-extraction": "./src/document-extraction/index.ts",
    "./document-reader": "./src/document-reader/index.ts",
    "./documents": "./src/documents/index.ts",
    "./sandbox": "./src/sandbox/index.ts",
    "./sheets": "./src/sheets/index.ts",
    "./skills": "./src/skills/index.ts",
    "./tools": "./src/tools/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "docling",
    "sandbox",
    "vendor",
    "vendor-lock.json",
    "THIRD_PARTY_NOTICES",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "test:office": "PRISM_TEST_LIBREOFFICE=1 bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src/documents/__tests__/golden.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pack:dry-run": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@office-open/docx": "0.14.5",
    "@office-open/pptx": "0.14.5",
    "@office-open/xlsx": "0.14.5",
    "@office-open/xml": "0.14.5",
    "ajv": "^8.17.1",
    "fast-xml-parser": "5.11.1"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0",
    "@firecrawl/anydoc": "0.2.4",
    "mammoth": "^1.8.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@arnilo/prism-workflows": "file:../../integrations/workflows",
    "@firecrawl/anydoc": "0.2.4",
    "@types/node": "^22.20.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^2.4.5",
    "playwright-core": "1.63.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/tools/work"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/tools/work#readme",
  "keywords": [
    "prism",
    "work",
    "connectors",
    "office",
    "documents",
    "document-reader",
    "sheets",
    "diagrams",
    "docx",
    "xlsx",
    "pptx",
    "drawio"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@firecrawl/anydoc": {
      "optional": true
    },
    "mammoth": {
      "optional": true
    },
    "pdf-parse": {
      "optional": true
    }
  }
}
