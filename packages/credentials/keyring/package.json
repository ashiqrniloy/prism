{
  "name": "@arnilo/prism-credentials-keyring",
  "version": "0.13.0",
  "description": "Credentials slot package for Prism: resolves keyring: refs through the OS keyring or an encrypted file, stores host-captured secrets and OAuth tokens, and delegates env: refs to the kernel default.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.0.0"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0"
  },
  "devDependencies": {
    "@arnilo/prism-provider-hyper": "file:../../providers/hyper",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/credentials/keyring"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/credentials/keyring#readme",
  "keywords": [
    "prism",
    "credentials",
    "keyring",
    "keychain",
    "secret-service",
    "encrypted-store",
    "slot"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
