{
  "name": "@arnilo/prism-wiki",
  "version": "0.13.0-experimental.0",
  "description": "The wiki for Prism agents: concepts, claims and sources in their own store, consolidated from cited evidence; reads long-term memory read-only when it is installed.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "!src/**/__tests__",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "bun ../../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@arnilo/prism": ">=0.13.0 <1.0.0",
    "@arnilo/prism-tools-web": "^0.13.0"
  },
  "peerDependenciesMeta": {
    "@arnilo/prism-tools-web": {
      "optional": true
    }
  },
  "dependencies": {
    "@arnilo/prism-memory-core": "0.13.0-experimental.0",
    "@arnilo/prism-rag": "0.13.0-experimental.0"
  },
  "devDependencies": {
    "@arnilo/prism-memory-fabric": "file:../../memory/fabric",
    "@arnilo/prism-tools-web": "file:../../tools/web",
    "@types/node": "^22.20.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/knowledge/wiki"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/knowledge/wiki#readme",
  "keywords": [
    "prism",
    "wiki",
    "ontology",
    "knowledge",
    "package"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
