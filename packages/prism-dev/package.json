{
  "name": "@arnilo/prism-dev",
  "version": "0.0.1",
  "description": "Loopback-only dev inspector over an already-configured Prism agent: pure composition of existing server, event-source, and renderer seams. No new runtime.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "bin": {
    "prism-dev": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./cli": {
      "types": "./dist/src/cli.d.ts",
      "default": "./dist/src/cli.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs node --test dist/src/__tests__/*.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@arnilo/prism": "^0.3.0",
    "@arnilo/prism-ag-ui": "^0.3.0",
    "@arnilo/prism-server": "^0.3.0"
  },
  "devDependencies": {
    "@arnilo/prism": "file:../..",
    "@arnilo/prism-ag-ui": "file:../ag-ui",
    "@arnilo/prism-server": "file:../server"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/prism-dev"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/prism-dev#readme",
  "keywords": [
    "prism",
    "dev",
    "inspector",
    "studio",
    "playground"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}