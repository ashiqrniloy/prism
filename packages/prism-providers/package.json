{
  "name": "@arnilo/prism-providers",
  "version": "0.4.1",
  "description": "Unified provider family: all 19 first-party Prism provider adapters as explicit subpaths (openai, anthropic, google, azure, bedrock, vertex, deepseek, xai, zai, alibaba, kimi, clinepass, neuralwatt, ollama, opencode-go, openrouter, ai-sdk, hyper, commandcode). Importing one adapter never evaluates another.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "default": "./dist/ai-sdk/index.js"
    },
    "./alibaba": {
      "types": "./dist/alibaba/index.d.ts",
      "default": "./dist/alibaba/index.js"
    },
    "./anthropic": {
      "types": "./dist/anthropic/index.d.ts",
      "default": "./dist/anthropic/index.js"
    },
    "./azure": {
      "types": "./dist/azure/index.d.ts",
      "default": "./dist/azure/index.js"
    },
    "./bedrock": {
      "types": "./dist/bedrock/index.d.ts",
      "default": "./dist/bedrock/index.js"
    },
    "./clinepass": {
      "types": "./dist/clinepass/index.d.ts",
      "default": "./dist/clinepass/index.js"
    },
    "./commandcode": {
      "types": "./dist/commandcode/index.d.ts",
      "default": "./dist/commandcode/index.js"
    },
    "./deepseek": {
      "types": "./dist/deepseek/index.d.ts",
      "default": "./dist/deepseek/index.js"
    },
    "./google": {
      "types": "./dist/google/index.d.ts",
      "default": "./dist/google/index.js"
    },
    "./hyper": {
      "types": "./dist/hyper/index.d.ts",
      "default": "./dist/hyper/index.js"
    },
    "./kimi": {
      "types": "./dist/kimi/index.d.ts",
      "default": "./dist/kimi/index.js"
    },
    "./neuralwatt": {
      "types": "./dist/neuralwatt/index.d.ts",
      "default": "./dist/neuralwatt/index.js"
    },
    "./ollama": {
      "types": "./dist/ollama/index.d.ts",
      "default": "./dist/ollama/index.js"
    },
    "./openai": {
      "types": "./dist/openai/index.d.ts",
      "default": "./dist/openai/index.js"
    },
    "./opencode-go": {
      "types": "./dist/opencode-go/index.d.ts",
      "default": "./dist/opencode-go/index.js"
    },
    "./openrouter": {
      "types": "./dist/openrouter/index.d.ts",
      "default": "./dist/openrouter/index.js"
    },
    "./vertex": {
      "types": "./dist/vertex/index.d.ts",
      "default": "./dist/vertex/index.js"
    },
    "./xai": {
      "types": "./dist/xai/index.d.ts",
      "default": "./dist/xai/index.js"
    },
    "./zai": {
      "types": "./dist/zai/index.d.ts",
      "default": "./dist/zai/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.map",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs node --test dist/*/__tests__/*.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@ai-sdk/provider": "4.0.9",
    "@arnilo/prism": "^0.4.0"
  },
  "peerDependenciesMeta": {
    "@ai-sdk/provider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.9",
    "@arnilo/prism": "file:../.."
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/prism-providers"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/prism-providers#readme",
  "keywords": [
    "prism",
    "providers",
    "agent",
    "llm"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
