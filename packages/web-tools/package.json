{
  "name": "@arnilo/prism-web-tools",
  "version": "0.5.0",
  "description": "Unified web tools family for Prism: bounded Brave/Exa/Firecrawl web research, Playwright browser automation with egress policy and quarantine, and Obscura browser-engine tools over a host-installed binary.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./brave": {
      "types": "./dist/brave.d.ts",
      "default": "./dist/brave.js"
    },
    "./exa": {
      "types": "./dist/exa.d.ts",
      "default": "./dist/exa.js"
    },
    "./firecrawl": {
      "types": "./dist/firecrawl.d.ts",
      "default": "./dist/firecrawl.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    },
    "./obscura": {
      "types": "./dist/obscura/index.d.ts",
      "default": "./dist/obscura/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs node --test dist/__tests__/*.test.js dist/browser/__tests__/*.test.js dist/obscura/__tests__/*.test.js",
    "test:live": "node --test dist/__tests__/live.test.js dist/browser/__tests__/live.test.js dist/obscura/__tests__/live.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@arnilo/prism": "^0.5.0",
    "@arnilo/prism-mcp": "^0.5.0",
    "playwright-core": "1.61.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arnilo/prism": "file:../..",
    "@arnilo/prism-core": "file:../prism-core",
    "@arnilo/prism-mcp": "file:../mcp",
    "playwright-core": "1.61.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/web-tools"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/web-tools#readme",
  "keywords": [
    "prism",
    "web-search",
    "exa",
    "brave",
    "firecrawl",
    "browser",
    "playwright",
    "obscura",
    "cdp"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
