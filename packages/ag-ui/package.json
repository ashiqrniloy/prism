{
  "name": "@arnilo/prism-ag-ui",
  "version": "0.12.0",
  "description": "Optional bounded AG-UI event mapper for Prism agent events.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./acp": {
      "types": "./dist/acp/index.d.ts",
      "default": "./dist/acp/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "default": "./dist/renderer/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/__tests__",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/with-build-lock.mjs tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun ../../scripts/with-build-lock.mjs --shared bun test --parallel=4 --timeout=0 dist/__tests__/*.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "dependencies": {
    "@ag-ui/core": "0.0.59",
    "@agentclientprotocol/sdk": "1.4.0",
    "@arnilo/prism-coding-tools": "^0.12.0"
  },
  "peerDependencies": {
    "@arnilo/prism": "^0.12.0",
    "@arnilo/prism-core": "^0.12.0",
    "@arnilo/prism-mcp": "^0.12.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "@arnilo/prism-core": {
      "optional": true
    },
    "@arnilo/prism-mcp": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ag-ui/client": "0.0.59",
    "@arnilo/prism": "file:../..",
    "@arnilo/prism-core": "file:../prism-core",
    "@arnilo/prism-mcp": "file:../mcp"
  },
  "engines": {
    "bun": ">=1.4.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/ag-ui"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/ag-ui#readme",
  "keywords": [
    "prism",
    "ag-ui",
    "agent",
    "interoperability"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
