{
  "name": "@arnilo/prism-channels",
  "version": "0.9.0",
  "description": "Messaging channels family for Prism: transport-neutral channel contracts, Prism execution adapter, durable bindings/journal/pairing, and (as subpaths) Telegram/Signal adapters.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./telegram": {
      "types": "./dist/telegram.d.ts",
      "default": "./dist/telegram.js"
    },
    "./signal": {
      "types": "./dist/signal.d.ts",
      "default": "./dist/signal.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.map",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/with-build-lock.mjs tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node ../../scripts/with-build-lock.mjs node --test dist/__tests__/runtime.test.js dist/__tests__/state.test.js dist/__tests__/recovery.test.js dist/__tests__/postgres.integration.test.js dist/__tests__/telegram.test.js dist/__tests__/signal.test.js dist/__tests__/end-to-end.test.js",
    "test:live": "node ../../scripts/with-build-lock.mjs node --test dist/__tests__/telegram-live.test.js dist/__tests__/signal-live.test.js",
    "test:postgres": "node ../../scripts/require-postgres-url.mjs && node ../../scripts/with-build-lock.mjs node --test dist/__tests__/postgres.integration.test.js",
    "pack:dry-run": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@arnilo/prism": "^0.9.0"
  },
  "devDependencies": {
    "@arnilo/prism": "file:../..",
    "@arnilo/prism-core": "file:../prism-core",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^13.0.3",
    "pg": "^8.23.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ashiqrniloy/prism.git",
    "directory": "packages/prism-channels"
  },
  "bugs": {
    "url": "https://github.com/ashiqrniloy/prism/issues"
  },
  "homepage": "https://github.com/ashiqrniloy/prism/tree/main/packages/prism-channels#readme",
  "keywords": [
    "prism",
    "channels",
    "messaging",
    "telegram",
    "signal",
    "agent",
    "runtime",
    "journal",
    "checkpoint",
    "session"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
