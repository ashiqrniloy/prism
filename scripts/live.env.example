# Prism live-test credentials — TEMPLATE (names only, safe to commit).
#
# Copy to `scripts/live.env` (gitignored) or anywhere outside the repo and point
# PRISM_LIVE_ENV_FILE at it. Fill only the vars for suites you intend to run;
# every other suite skips cleanly with a reason.
#
#   cp scripts/live.env.example scripts/live.env   # in-repo, gitignored
#   # or, safest against any git accident:
#   cp scripts/live.env.example ~/.config/prism/live.env
#   export PRISM_LIVE_ENV_FILE="$HOME/.config/prism/live.env"
#
# Run a suite with the file loaded (Node >= 20 native, no dotenv dependency):
#
#   node --env-file=scripts/live.env --test dist/openai/__tests__/live.test.js
#
# Rules:
# - Keys live in env vars only. Never in shell rc files (shell history),
#   never in committed files, never in test output (suites assert
#   assertNoSecretLeak over every streamed event).
# - Use the cheapest/least-privileged key per service: project-scoped,
#   spend-capped, single-purpose. Each suite issues only 1-3 requests.
# - CI never reads this file — GitHub Environments hold secrets instead
#   (see .github/workflows/live-canaries.yml for the existing pattern).

# ── master switches ──────────────────────────────────────────────────────────
# Opt-in flags per suite family. Without these, every live suite skips even if
# keys below are present.
PRISM_LIVE_PROVIDER_TESTS=1        # provider live suites (packages/prism-providers)
PRISM_LIVE_WEB=1                   # web search/fetch (brave/exa/firecrawl)
PRISM_LIVE_PLAYWRIGHT=1            # browser live (real Chromium, no key needed)
PRISM_LIVE_OBSCURA=1               # obscura live (local CLI binary, no key)
PRISM_LIVE_OBSERVATIONAL_MEMORY_TESTS=1  # observational-memory live (reuses OPENAI_API_KEY)
PRISM_LIVE_COMPACTION_TESTS=1       # LLM compaction live (provider key TBD by plan 064 Task 6)
PRISM_TEST_LIBREOFFICE=1           # office golden renders (local LibreOffice, no key)
PRISM_TEST_ACP_CLIENT=1            # ACP real-client stdio smoke (real SDK client, no key)

# ── provider keys (pick the ones you have) ───────────────────────────────────
OPENAI_API_KEY=sk-...              # openai + observational-memory live
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...                # google (suite also accepts GOOGLE_API_KEY)
CLINE_API_KEY=...
COMMAND_CODE_API_KEY=...
DEEPSEEK_API_KEY=...
HYPER_API_KEY=sk-hyper-...
KIMI_API_KEY=...
NEURALWATT_API_KEY=...
OPENCODE_API_KEY=...
OPENROUTER_API_KEY=sk-or-...
XAI_API_KEY=xai-...
ZAI_API_KEY=...
PRISM_LIVE_DASHSCOPE_KEY=...      # alibaba
PRISM_LIVE_DASHSCOPE_MODEL=qwen-plus   # alibaba (model to probe)

# ── provider model overrides (optional) ─────────────────────────────────────
# Each provider live suite probes ONE model. Unset = the manifest default
# (scripts/live-matrix.json `model[].default`). Set = override. Multi-probe
# suites use suffixed vars. All 20 provider suites honor their override
# (wired: true) since plans/064 Task 4.
# PRISM_LIVE_OPENAI_MODEL=gpt-5-mini
# PRISM_LIVE_ANTHROPIC_MODEL=claude-sonnet-4
# PRISM_LIVE_GOOGLE_MODEL=gemini-2.5-flash
# PRISM_LIVE_DASHSCOPE_MODEL=qwen-plus   # embedding model (text-embedding-v4)
# PRISM_LIVE_CLINEPASS_MODEL=...
# PRISM_LIVE_COMMANDCODE_CHAT_MODEL=...  # + _MESSAGES_MODEL, _GPT_MODEL
# PRISM_LIVE_DEEPSEEK_MODEL=deepseek-chat
# PRISM_LIVE_HYPER_CHAT_MODEL=...        # + _MESSAGES_MODEL
# PRISM_LIVE_KIMI_MODEL=...
# PRISM_LIVE_NEURALWATT_MODEL=...
# PRISM_LIVE_OPENCODE_MODEL=...
# PRISM_LIVE_OPENROUTER_MODEL=anthropic/claude-sonnet-4
# PRISM_LIVE_XAI_MODEL=grok-4-fast
# PRISM_LIVE_ZAI_MODEL=...
# PRISM_LIVE_AZURE_MODEL=<deployment-name>   # azure: deployment IS the model knob
# PRISM_LIVE_BEDROCK_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# PRISM_LIVE_VERTEX_MODEL=gemini-2.5-flash
# PRISM_LIVE_OLLAMA_MODEL=<pulled-model>     # default: first model the server lists
# PRISM_LIVE_AISDK_MODEL=gpt-5.1             # @ai-sdk/openai leg

# xai OAuth leg (in addition to XAI_API_KEY)
PRISM_LIVE_XAI_OAUTH=1

# ── web tools ────────────────────────────────────────────────────────────────
PRISM_BRAVE_SEARCH_TOKEN=...      # Brave Search API token
PRISM_EXA_API_KEY=...
PRISM_FIRECRAWL_API_KEY=...

# ── office diagrams ──────────────────────────────────────────────────────────
PRISM_LIVE_DRAWIO_URL=https://... # drawio export service the live suite calls
# (PRISM_TEST_DRAWIO_URL is the older alias; set either)

# ── real binaries/services (no secrets, just pointers) ──────────────────────
PRISM_OBSCURA_BIN=/path/to/obscura            # obscura CLI for live obscura leg
PRISM_TEST_PLAYWRIGHT=1                       # hermetic-but-real Chromium leg
PRISM_TEST_LIBREOFFICE=1                       # (duplicate of master switch above)
PRISM_TEST_POSTGRES_URL=postgres://user:pass@localhost:5432/prism_test
PRISM_TEST_NATS_URL=nats://localhost:4222
PRISM_TEST_KEYCHAIN=1                          # OS keychain credential-store leg
PRISM_TEST_DOCKER_BIN=docker                   # coding sandbox legs
PRISM_TEST_DOCKER_IMAGE=...                    # pinned minimal sandbox image
PRISM_TEST_DOCKER_USER=...                     # non-root sandbox user
PRISM_TEST_DOCKER_SANDBOX=1

# ── canaries against DEPLOYED prism instances (see scripts/live-canary.mjs) ─
# PRISM_CANARY_PROVIDER_URL=https://your-prism-provider.example/
# PRISM_CANARY_PROVIDER_API_KEY=...
# PRISM_CANARY_PROVIDER_MODEL=...
# PRISM_CANARY_MCP_URL=https://your-prism-mcp.example/
# PRISM_CANARY_MCP_TOKEN=...
# PRISM_CANARY_A2A_URL=https://your-prism-a2a.example/
# PRISM_CANARY_A2A_TOKEN=...

# ── plans/064 Task 4 providers (azure / bedrock / vertex / ollama / ai-sdk) ─
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=...                  # or Entra bearer via authStyle
# AWS_ACCESS_KEY_ID=...                     # bedrock (SigV4, static keys)
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=...                     # only for temporary credentials
# GOOGLE_VERTEX_PROJECT=my-project          # vertex
# GOOGLE_VERTEX_LOCATION=us-central1
# PRISM_VERTEX_ACCESS_TOKEN=...             # e.g. gcloud auth print-access-token
# OLLAMA_BASE_URL=http://localhost:11434    # local ollama serve (no key needed)

# ── planned by plans/064 (no suites yet — leave unset until those tasks land) ─
# PRISM_TEST_OPA_URL                                   (OPA evaluator, Task 9)
# PRISM_TEST_OIDC_ISSUER / _AUDIENCE / _TOKEN          (OIDC/JWKS, Task 9)
# PRISM_TEST_WEBHOOK_URL (+ secret)                    (outbound webhooks, Task 9)
# PRISM_TEST_S3_ENDPOINT / _KEY / _SECRET / _BUCKET     (artifact bodies, Task 9)
# PRISM_TEST_TEI_RERANK_URL / PRISM_TEST_HOSTED_RERANK_URL (+ key) (RAG, Task 6)

# plans/064 Task 9 — prism-core governance/runtime real legs
# core/opa-live: real OPA decision endpoint (no key, or + token in your proxy)
#PRISM_TEST_OPA_URL=https://opa:8181/v1/data/prism/allow
# core/oidc-live: real issuer + audience + a real bearer token (JWKS URL optional)
#PRISM_TEST_OIDC_ISSUER=https://id.example.com/tenant
#PRISM_TEST_OIDC_AUDIENCE=prism-api
#PRISM_TEST_OIDC_TOKEN=
#PRISM_TEST_OIDC_JWKS_URL=https://id.example.com/tenant/.well-known/jwks.json
# core/webhooks-live: an HTTPS receiver you own + shared HMAC key (>= 32 bytes)
#PRISM_TEST_WEBHOOK_URL=https://ops.example.com/hooks/prism
#PRISM_TEST_WEBHOOK_SECRET=prism-live-webhook-secret-0123456789abcdef
# core/artifact-bodies-s3-live: real S3-compatible endpoint + throwaway bucket
#PRISM_TEST_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
#PRISM_TEST_S3_KEY=
#PRISM_TEST_S3_SECRET=
#PRISM_TEST_S3_BUCKET=prism-throwaway
#PRISM_TEST_S3_REGION=us-east-1
