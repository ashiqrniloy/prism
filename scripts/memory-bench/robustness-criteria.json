{
  "schemaVersion": 1,
  "plan": 202,
  "frozen": "2026-10-27",
  "hashRule": "sha256 over canonical JSON of this file, exposed by robustnessCriteriaHash(); every later manifest and report pins it",
  "ownerDecisions": {
    "costRegime": {
      "date": "2026-10-27",
      "decision": "both",
      "governs": "warm-cached-prefix",
      "reason": "A product sends its history as a cached prefix, so the warm cached-prefix regime is the realistic comparator (R11). The cold one-shot cost is still reported, because the task's cost row otherwise flips with the cache-read ratio (Task 1 (b))."
    },
    "locomoLicense": {
      "date": "2026-10-27",
      "decision": "accepted",
      "scope": "benchmark use only",
      "reason": "LoCoMo is CC BY-NC 4.0 (noncommercial). Evidence is published under that restriction; reports hold ids, counts and scores only, never corpus text."
    }
  },
  "suites": {
    "inWindow": ["beam-100k", "locomo", "memoryagentbench-cr"],
    "beyondWindow": ["longmemeval-m", "beam-1m"],
    "optional": ["beam-500k", "beam-10m"],
    "developmentOnly": ["longmemeval-s"],
    "coding": ["coding-longitudinal", "memorycode", "vibemembench", "dreambench-swe"],
    "unavailable": ["statemembench"],
    "unavailableReason": "StateMemBench (arXiv 2608.19652) has no released dataset or code as of 2026-10-27. State tracking is mapped to memoryagentbench-cr, longmemeval-m knowledge-update and beam-1m contradiction_resolution."
  },
  "comparators": ["full", "full-truncated", "lexical-topk", "preset-r1", "passive-only"],
  "bfc": {
    "perAnswerModel": true,
    "inWindow": {
      "suites": ["beam-100k", "locomo", "memoryagentbench-cr"],
      "vs": "full",
      "pooledDiffCiLow": 0,
      "perSuiteNonInferiority": 0.03
    },
    "beyondWindow": {
      "suites": ["longmemeval-m", "beam-1m"],
      "vs": ["full-truncated", "lexical-topk"],
      "ciLow": 0
    },
    "cost": {
      "ratio": 0.5,
      "metric": "cache-adjusted input cost per question",
      "regimes": ["cold-oneshot", "warm-cached-prefix"],
      "governing": "warm-cached-prefix"
    },
    "latency": {
      "p95PerTurnAddedLatencyRatio": 2
    }
  },
  "robust": {
    "models": {
      "minAnswerModels": 3,
      "minProviders": 2
    },
    "abilities": {
      "maxBelowFullPoints": 5,
      "includes": ["abstention", "single-session-preference"]
    },
    "smallModel": {
      "notBelow": "passive-only",
      "maxBelowFullPoints": 5
    },
    "variance": {
      "repeats": 3,
      "subsetItems": 100,
      "maxAccuracySdPoints": 3,
      "report": "pass^3"
    },
    "judges": {
      "minJudges": 2,
      "distinctFamilies": true,
      "minPanelHumanKappa": 0.8
    },
    "safetyGate": "Task 14",
    "growthGate": "Task 15",
    "coding": {
      "suite": "coding-longitudinal",
      "personas": 12,
      "taskSuccess": {
        "vs": ["memory-off", "conversational"],
        "ciLowVsMemoryOff": 0
      },
      "supersededDecisionAppliedMaxRate": 0.02,
      "crossProjectLeakage": 0,
      "foreignContextExposure": 0,
      "poisonCanaryActive": 0,
      "memorycodeLatestInstructionNonInferiorToFull": true,
      "vibemembenchNonInferiorityPoints": 2
    }
  },
  "heldOutGuard": {
    "partitions": ["heldout-a", "heldout-b"],
    "refusedBy": ["retrieval-diagnostics", "ceilingScan", "multiSessionDiagnostic"],
    "heldoutBUse": "one remediation round after a Task 18 miss, then end of plan"
