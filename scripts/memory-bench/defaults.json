        "maxFiles": 10,
        "maxTokens": 200,
        "stopWords": false
      },
      "rules": {
        "maxTokens": 600,
        "scopes": [
          "user",
          "project"
        ],
        "kinds": [
          "fact",
          "preference",
          "procedure",
          "decision"
        ],
        "capture": "off"
      },
      "cues": {
        "budgetTokens": 300,
        "maxPerTurn": 2
      },
      "team": false,
      "exchanges": {
