        "scope": "user",
        "steps": false
      },
      "lessons": {
        "nudge": false,
        "minTurnsBetweenNudges": 5,
        "archiveAfterSessions": 20
      },
      "lifecycle": {
        "verifyAfterSessions": 2,
        "decay": {
          "episode": 0.8,
          "fact": 0.4,
          "preference": 0.2,
          "procedure": 0.4,
          "decision": 0.2,
          "file": 0.4,
          "exchange": 0.5
        },
        "storageWeights": {
          "explicit": 1,
          "sessions": 0.5,
          "helpful": 0.5,
          "harmful": 1,
          "outcome": 0.5
        },
        "recall": {
          "retrieval": 0.05,
          "storage": 0.05
        },
        "archive": {
          "retrievalBelow": -2,
          "storageBelow": 1,
          "graceSessions": 10,
          "lessonSessions": 20
        },
        "capacity": {
          "user": {
            "notes": 200,
            "tokens": 20000
          },
          "agent": {
            "notes": 200,
            "tokens": 20000
          },
          "project": {
            "notes": 500,
            "tokens": 60000
          }
        },
        "exchangeCapacity": {
          "hotTokens": 200000
        },
        "merge": {
          "duplicateDice": 0.8
        }
      },
      "recall": {
        "expansion": false,
        "gather": false
      },
      "promote": {
        "enabled": false,
        "minScore": 0.5,
        "maxCandidates": 48,
        "minTurnsBetween": 8,
        "derivableFrom": [
          "AGENTS.md",
          "README.md",
          "package.json",
          "CLAUDE.md"
