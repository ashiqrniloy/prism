            "notes": 200,
            "tokens": 20000
          },
          "agent": {
            "notes": 200,
            "tokens": 20000
          },
          "project": {
            "notes": 500,
            "tokens": 60000
          }
        },
        "merge": {
          "duplicateDice": 0.8
        },
        "widen": {
          "minProjects": 2,
          "minSiblings": 2,
          "contradictionsToSupersede": 2
        }
