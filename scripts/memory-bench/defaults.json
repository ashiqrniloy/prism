{
  "status": "provisional; no live verdict",
  "defaults": {
    "observational": {
      "enabled": false,
      "recall": true,
      "stm": {
        "triggerTokens": 10000,
        "contextTokens": 4000,
        "maxChunksPerEvent": 2,
        "maxChunkBytes": 4096,
        "chunkStore": "memory",
        "habituation": {
          "windowEvents": 50
        },
        "boundaries": false,
        "boundaryGapMinutes": 10
      },
      "wm": {
        "enabled": true,
        "observationTokens": 20000
      },
      "rehearsal": {
        "enabled": true,
        "targetTokens": 20000,
